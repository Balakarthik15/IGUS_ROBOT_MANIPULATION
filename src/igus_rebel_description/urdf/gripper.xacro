<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="gripper" params="parent_link prefix:=''">

    <!-- ========================= -->
    <!-- Parameters in meters -->
    <!-- ========================= -->

    <xacro:property name="mount_radius" value="0.0375"/>       <!-- 75 mm diameter -->
    <xacro:property name="mount_height" value="0.020"/>

    <xacro:property name="body_x" value="0.080"/>
    <xacro:property name="body_y" value="0.080"/>
    <xacro:property name="body_z" value="0.050"/>

    <xacro:property name="finger_x" value="0.018"/>            <!-- finger depth -->
    <xacro:property name="finger_y" value="0.012"/>            <!-- finger thickness -->
    <xacro:property name="straight_len" value="0.040"/>        <!-- 40 mm -->
    <xacro:property name="bottom_len" value="0.025"/>          <!-- 25 mm -->
    <xacro:property name="tapered_len" value="0.035"/>         <!-- 35 mm -->

    <xacro:property name="max_finger_travel" value="0.050"/>   <!-- 50 mm each side -->
    <xacro:property name="finger_start_y" value="0.010"/>

    <!-- ========================= -->
    <!-- Materials -->
    <!-- ========================= -->

    <material name="gripper_black">
      <color rgba="0.02 0.02 0.02 1"/>
    </material>

    <material name="gripper_dark_grey">
      <color rgba="0.08 0.08 0.08 1"/>
    </material>

    <!-- ========================= -->
    <!-- Gripper base link -->
    <!-- ========================= -->

    <link name="${prefix}gripper_base_link">

      <!-- Circular mounting base -->
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${mount_radius}" length="${mount_height}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${mount_radius}" length="${mount_height}"/>
        </geometry>
      </collision>

      <!-- Main gripper body -->
      <visual>
        <origin xyz="0 0 -0.040" rpy="0 0 0"/>
        <geometry>
          <box size="${body_x} ${body_y} ${body_z}"/>
        </geometry>
        <material name="gripper_dark_grey"/>
      </visual>

      <collision>
        <origin xyz="0 0 -0.040" rpy="0 0 0"/>
        <geometry>
          <box size="${body_x} ${body_y} ${body_z}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 -0.030"/>
        <mass value="0.35"/>
        <inertia ixx="0.001" ixy="0" ixz="0"
                 iyy="0.001" iyz="0"
                 izz="0.001"/>
      </inertial>

    </link>

    <!-- Fixed mounting to ReBeL flange/tool link -->
    <joint name="${prefix}gripper_mount_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- ========================= -->
    <!-- Left finger link -->
    <!-- ========================= -->

    <link name="${prefix}left_finger_link">

      <!-- Straight vertical part: 40 mm -->
      <visual>
        <origin xyz="0 0 -0.070" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${straight_len}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 -0.070" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${straight_len}"/>
        </geometry>
      </collision>

      <!-- Bottom inward pad: 25 mm -->
      <visual>
        <origin xyz="0 -0.0125 -0.095" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${bottom_len} ${finger_y}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 -0.0125 -0.095" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${bottom_len} ${finger_y}"/>
        </geometry>
      </collision>

      <!-- Tapered support approximation: 35 mm diagonal -->
      <visual>
        <origin xyz="0 -0.006 -0.052" rpy="0.55 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${tapered_len}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 -0.006 -0.052" rpy="0.55 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${tapered_len}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 -0.070"/>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
      </inertial>

    </link>

    <joint name="${prefix}left_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}left_finger_link"/>
      <origin xyz="0 ${finger_start_y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="${max_finger_travel}" effort="20" velocity="0.05"/>
    </joint>

    <!-- ========================= -->
    <!-- Right finger link -->
    <!-- ========================= -->

    <link name="${prefix}right_finger_link">

      <!-- Straight vertical part: 40 mm -->
      <visual>
        <origin xyz="0 0 -0.070" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${straight_len}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 -0.070" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${straight_len}"/>
        </geometry>
      </collision>

      <!-- Bottom inward pad: 25 mm -->
      <visual>
        <origin xyz="0 0.0125 -0.095" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${bottom_len} ${finger_y}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 0.0125 -0.095" rpy="0 0 0"/>
        <geometry>
          <box size="${finger_x} ${bottom_len} ${finger_y}"/>
        </geometry>
      </collision>

      <!-- Tapered support approximation: 35 mm diagonal -->
      <visual>
        <origin xyz="0 0.006 -0.052" rpy="-0.55 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${tapered_len}"/>
        </geometry>
        <material name="gripper_black"/>
      </visual>

      <collision>
        <origin xyz="0 0.006 -0.052" rpy="-0.55 0 0"/>
        <geometry>
          <box size="${finger_x} ${finger_y} ${tapered_len}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 -0.070"/>
        <mass value="0.05"/>
        <inertia ixx="0.0001" ixy="0" ixz="0"
                 iyy="0.0001" iyz="0"
                 izz="0.0001"/>
      </inertial>

    </link>

    <joint name="${prefix}right_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}right_finger_link"/>
      <origin xyz="0 ${-finger_start_y} 0" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="${max_finger_travel}" effort="20" velocity="0.05"/>
    </joint>

    <!-- ========================= -->
    <!-- TCP link -->
    <!-- ========================= -->

    <link name="${prefix}tcp_link"/>

    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}tcp_link"/>
      <origin xyz="0 0 -0.100" rpy="0 0 0"/>
    </joint>

  </xacro:macro>

</robot>
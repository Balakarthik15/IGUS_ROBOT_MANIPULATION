<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Real gripper with STL meshes and fixed finger joints (the real gripper is digital open/close only). -->

  <link name="gripper_base">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="file://$(find igus_rebel_description)/meshes/gripper/gripper_base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>
    </visual>

    <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
            <mesh filename="file://$(find igus_rebel_description)/meshes/gripper/gripper_base.stl"
                  scale="0.001 0.001 0.001"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia
            ixx="0.01" ixy="0" ixz="0"
            iyy="0.01" iyz="0"
            izz="0.01"/>
    </inertial>
  </link>

  <link name="gripper_left">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="file://$(find igus_rebel_description)/meshes/gripper/left_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="file://$(find igus_rebel_description)/meshes/gripper/left_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>

  </link>

  <joint name="gripper_mount_joint" type="fixed">
    <parent link="link6"/>
    <child link="gripper_base"/>

    <origin
    xyz="0 -0.02 0.054"
    rpy="1.570796 0 0"/>
  </joint>

  <joint name="gripper_left_joint" type="fixed">

    <parent link="gripper_base"/>
    <child link="gripper_left"/>

    <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

    <axis
        xyz="0 0 1"/>

    <limit
        lower="-1.57"
        upper="1.57"
        effort="10"
        velocity="1.0"/>

  </joint>

  <link name="gripper_right">

    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="file://$(find igus_rebel_description)/meshes/gripper/right_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh
          filename="file://$(find igus_rebel_description)/meshes/gripper/right_link.stl"
          scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.001"
        ixy="0"
        ixz="0"
        iyy="0.001"
        iyz="0"
        izz="0.001"/>
    </inertial>
  </link>

  <joint name="gripper_right_joint" type="fixed">

    <parent link="gripper_base"/>
    <child link="gripper_right"/>

    <origin
        xyz="0 0 0"
        rpy="0 0 0"/>

    <axis
        xyz="0 0 1"/>

    <limit
        lower="-1.57"
        upper="1.57"
        effort="10"
        velocity="1.0"/>

  </joint>

</robot>